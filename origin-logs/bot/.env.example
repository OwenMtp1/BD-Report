# ============================================================
# Origin Logs — bot Discord
# Copiez ce fichier en « .env » et remplissez-le.
# ⚠️ .env ne se versionne JAMAIS : il contient deux secrets.
# ============================================================

# --- Le panneau ---
PANEL_URL=http://127.0.0.1:8080
# ⚠️ La clé du BOT, pas celle du serveur de jeu. Elle se délivre dans
# Supervision → la carte de l'espace → « Clé du bot Discord ».
# Elle ne sait que LIRE : la retirer coupe le bot, jamais les journaux.
RELAY_KEY=

# --- Discord ---
# Portail développeur → votre application → Bot → Reset Token
DISCORD_TOKEN=
# Clic droit sur votre serveur → Copier l'identifiant
# (il faut activer le mode développeur dans les paramètres de Discord)
DISCORD_GUILD_ID=

# --- Facultatif ---
# Préfixe des salons créés, par exemple « logs- » → #logs-anticheat
CHANNEL_PREFIX=
# Rôle mentionné sur les évènements graves. Vide = aucune mention.
# ⚠️ Mentionner sur tout revient à ne mentionner sur rien.
PING_ROLE_ID=
PING_SEVERITIES=critique
# Rubriques suivies (vide = toutes) : bans,anticheat,reports,…
CATEGORIES=
# Gravités suivies (vide = toutes) : critique,alerte,notice,info
SEVERITIES=
# Au-delà de ce nombre d'évènements d'un coup dans un salon, le bot
# RÉSUME au lieu de détailler. Une rubrique bavarde noie sinon le salon.
MAX_PER_CHANNEL=8
# Cadence du sondage, en millisecondes.
POLL_MS=5000
# Créer les salons manquants au démarrage (le bot a besoin du droit
# « Gérer les salons »). Mettez 0 pour les créer vous-même.
CREATE_CHANNELS=1
VERBOSE=0
