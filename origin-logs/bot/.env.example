# ============================================================
# Origin Logs — bot Discord
# Copiez ce fichier en « .env ».
#
# ⚠️ PRESQUE RIEN NE SE RÈGLE ICI. Le jeton Discord, le serveur, le rôle
# mentionné, les rubriques suivies : tout cela se règle DANS LE PANNEAU,
# par chaque client, depuis « Liaison Discord → Bot Discord ».
# Ce fichier ne dit que deux choses — où est le panneau, et avec quelle clé.
# ============================================================

PANEL_URL=http://127.0.0.1:8080

# --- Choisissez UN mode ---
#
# A) TOUS LES ESPACES — un seul processus sert tous vos clients.
#    C'est le mode de l'éditeur. La même valeur que BOT_KEY dans api/.env.
#    Ajouter un client dans le panneau suffit : rien à relancer.
BOT_KEY=
#
# B) UN SEUL ESPACE — pour un serveur qui héberge son propre panneau.
#    La clé se délivre toute seule quand on branche un bot dans le panneau ;
#    on peut aussi la voir dans Supervision → la carte de l'espace.
#RELAY_KEY=

# --- Facultatif ---
POLL_MS=5000              # cadence du sondage
INVENTORY_MS=120000       # à quelle fréquence on redemande la liste des espaces
VERBOSE=0

# ⚠️ Repli d'installation, mode « un seul espace » UNIQUEMENT : si le
# client n'a pas encore réglé son Discord dans le panneau, on accepte le
# jeton ici. Ce n'est pas le chemin normal.
#DISCORD_TOKEN=
#DISCORD_GUILD_ID=
