{
  "name": "bdr-flow-pro",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "smoke": "vite build --ssr scripts/smoke.jsx --outDir .smoke --emptyOutDir && node .smoke/smoke.js",
    "audit": "vite build --ssr scripts/audit.jsx --outDir .audit --emptyOutDir && node .audit/audit.js && node scripts/mtRoundtrip.mjs && node scripts/worker-test.mjs && node scripts/i18n-coverage.mjs",
    "i18n:missing": "node scripts/i18n-coverage.mjs --list",
    "shots": "npm run build && node scripts/screenshots.mjs && SHOT_THEME=light node scripts/screenshots.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "lucide-react": "^0.452.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "jsdom": "^29.1.1",
    "playwright-core": "^1.63.0",
    "postcss": "^8.4.47",
    "puppeteer": "^25.1.0",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8"
  }
}
